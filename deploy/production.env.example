HTTP_SERVER_ADDR=:8080
HTTP_SERVER_READ_TIMEOUT=30s
HTTP_SERVER_WRITE_TIMEOUT=30s
HTTP_SERVER_IDLE_TIMEOUT=60s
HTTP_SERVER_SHUTDOWN_TIMEOUT=30s
HTTP_SERVER_MAX_HEADER_BYTES=1048576
HTTP_SERVER_MAX_BODY_BYTES=10485760
HTTP_SERVER_MAX_WORKERS=8
HTTP_SERVER_QUEUE_SIZE=16
HTTP_SERVER_MAX_CONNECTIONS=10000
HTTP_SERVER_MAX_IDLE_CONNECTIONS=100
HTTP_SERVER_READ_BUFFER_SIZE=4096
HTTP_SERVER_WRITE_BUFFER_SIZE=4096
HTTP_SERVER_ENABLE_KEEP_ALIVE=true
HTTP_SERVER_ENABLE_COMPRESSION=true
HTTP_SERVER_COMPRESSION_LEVEL=6
# HTTP_SERVER_TLS_CERT_FILE=/run/secrets/tls.crt
# HTTP_SERVER_TLS_KEY_FILE=/run/secrets/tls.key
# HTTP_SERVER_STATIC_DIR=/app/public
HTTP_SERVER_STATIC_URL_PATH=/static
